{
  "name": "@events/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @events/api-contracts build && tsx watch src/index.ts",
    "dev:watch": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "export:openapi": "tsx scripts/export-openapi.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/events/domain/event.test.ts src/events/application/event-service.test.ts src/server.test.ts"
  },
  "dependencies": {
    "@events/api-contracts": "workspace:*",
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^10.1.5",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@supabase/supabase-js": "^2.57.4",
    "dotenv": "^18.0.4",
    "fastify": "^5.5.0",
    "fastify-type-provider-zod": "^5.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
